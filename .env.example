# Copy to .env and fill in before running `docker compose up`.

# Postgres password for the shawk-db user (also used by shawk-server).
POSTGRES_PASSWORD=change-me

# Shared secret for the probe-registration endpoint (POST /api/probes).
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me

# Host group allowed to log into the dashboard.
DASHBOARD_GROUP=syshawk

# URL the *browser* will use to reach shawk-server - not the internal
# compose network name. In production this should be the same public
# hostname the dashboard is served from, with a reverse-proxy path (e.g.
# https://monitor.lgjt.xyz/api) so the session cookie stays same-origin.
PUBLIC_API_URL=http://localhost:8080
